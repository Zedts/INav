# MyQuran API Configuration
MYQURAN_API_BASE_URL=https://api.myquran.com/v2
MYQURAN_API_BASE_URL_ALT=https://api.myquran.com/v3
# Mosque Finder API (primary: time.now — uses lat + lon; secondary: masjidnear.me — uses lat + lng + rad in meters)
MOSQUE_FINDER_API_BASE_URL=https://time.now/mosques/api/mosques
MOSQUE_FINDER_API_BASE_URL_ALT=https://api.masjidnear.me

# Default City ID (Change to your city)
# Get city ID from: https://api.myquran.com/v3/sholat/kota/semua
DEFAULT_CITY_ID=1301

# Timezone
DEFAULT_TIMEZONE=Asia/Jakarta
